# Dados brutos e processados (não versionar arquivos grandes)
dados/brutos/
dados/processados/
!dados/brutos/.gitkeep
!dados/processados/.gitkeep

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.eggs/
*.egg

# Ambientes virtuais
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/

# IDE
.vscode/
.idea/

# OS
Thumbs.db
.DS_Store

# Resultados grandes (versionar apenas os finais)
resultados/graficos/*.png
resultados/graficos/*.pdf
!resultados/graficos/.gitkeep
